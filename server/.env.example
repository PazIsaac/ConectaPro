# Servidor
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Seguridad
# Generar un valor largo y aleatorio para producción.
JWT_SECRET=cambiar-este-valor-en-produccion
JWT_EXPIRA=8h

# SQL Server
DB_SERVER=localhost\SQLEXPRESS
DB_NAME=ConectaPro
# true = autenticación integrada de Windows (recomendado en desarrollo local)
DB_TRUSTED=true
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Inteligencia artificial (opcional).
# Sin clave, la API usa el motor local de clasificación por palabras clave.
IA_API_KEY=
IA_BASE_URL=https://api.openai.com/v1
IA_MODEL=gpt-4o-mini
IA_TIMEOUT_MS=20000

# Contraseña de las cuentas de demostración creadas por setup:db.
# No usar en producción.
DEMO_PASSWORD=Demo1234!
